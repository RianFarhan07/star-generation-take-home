# Copy to .env.local and fill in from `npx supabase status -o env` (local Supabase).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-or-publishable-key
# Used only by the test suite to create users and backdate rows. Never used by the app.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-or-secret-key
